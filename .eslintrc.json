{
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-duplicate-imports": "error",
    "no-unreachable": "error",
    "no-constant-condition": "warn",
    "no-debugger": "warn"
  }
}
