{
  "appId": "com.cet46.app",
  "productName": "CET46 科学记忆引擎",
  "copyright": "Copyright © 2024-2026 CET46 Team",
  "directories": {
    "output": "release",
    "app": "."
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "icons/**/*.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "dist",
      "to": "dist"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "ia32"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "icons/icon-512.png",
    "publisherName": "CET46 Team"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CET46 科学记忆引擎",
    "installerIcon": "icons/icon-512.png",
    "uninstallerIcon": "icons/icon-512.png",
    "installerHeaderIcon": "icons/icon-512.png"
  },
  "portable": {
    "artifactName": "CET46-Portable-${version}.exe"
  },
  "asar": true,
  "asarUnpack": [
    "dist/**/*"
  ],
  "electronDownload": {
    "cache": "./electron-cache",
    "mirror": "https://npmmirror.com/mirrors/electron/"
  }
}
