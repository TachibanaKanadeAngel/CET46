/* ==========================================================================
   46英语 - 全局像素农场设计系统 (Pixel Farm Design System)
   ========================================================================== */

view, scroll-view, button, text, image, picker, progress, input, textarea, navigator, progress-bar {
  box-sizing: border-box;
}

/* 默认 / 晨光农场明亮主题 (Cozy Golden Wheat & Warm Timber) */
page,
page[data-theme='light'] {
  --sv-bg-base: #f6e6ba;
  --sv-bg-grid: #ecd19a;
  --sv-panel-base: #fffaf1;
  --sv-panel-shadow: #c3915f;
  --sv-border: #422613;
  --sv-border-dark: #3b200e;
  --sv-text-main: #33231a;
  --sv-panel-light: #ffffff;
  --sv-wood-base: #dfa873;
  --sv-bar-bg: #4f331f;
  
  --sv-energy-green: #2e7d32;
  --sv-energy-dark: #1b5e20;
  --sv-energy-light: #e8f5e9;
  
  --sv-heat-red: #c62828;
  --sv-heat-dark: #8e0000;
  --sv-heat-light: #ffebee;
  
  --sv-coin-gold: #f59e0b;
  --sv-coin-shadow: #d97706;
  
  --sv-warning-yellow: #d97706;
  --sv-warning-text: #422613;
  
  --sv-success-text: #ffffff;
  --sv-danger-text: #ffffff;

  --primary: #2e7d32;
  --success: var(--sv-energy-green);
  --danger: var(--sv-heat-red);
  --warning: var(--sv-warning-yellow);
  --dark: var(--sv-border);
  --gray: #68492f;
  --light-gray: #72553a;
  --light: var(--sv-panel-base);
  --card-bg: var(--sv-panel-base);
  --text-color: var(--sv-text-main);
  --border-color: var(--sv-panel-shadow);

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  background-color: var(--sv-bg-base);
  color: var(--sv-text-main);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 系统深色模式与夜间星空农场暗黑主题 (Midnight Starlit Farm) */
@media (prefers-color-scheme: dark) {
  page:not([data-theme='light']) {
    --sv-bg-base: #151322;
    --sv-bg-grid: #201c34;
    --sv-panel-base: #241f38;
    --sv-panel-shadow: #0e0b17;
    --sv-border: #4d426d;
    --sv-border-dark: #120e1e;
    --sv-text-main: #f5f3fc;
    --sv-panel-light: #322b4d;
    --sv-wood-base: #463b65;
    --sv-bar-bg: #100d1a;
    
    --sv-energy-green: #38a169;
    --sv-energy-dark: #1e6b37;
    --sv-energy-light: #1c3826;
    
    --sv-heat-red: #e53e3e;
    --sv-heat-dark: #9b2c2c;
    --sv-heat-light: #441c22;
    
    --sv-coin-gold: #ecc94b;
    --sv-coin-shadow: #b7791f;
    
    --sv-warning-yellow: #d69e2e;
    --sv-warning-text: #151322;
    
    --sv-success-text: #ffffff;
    --sv-danger-text: #ffffff;

    --primary: #38a169;
    --success: var(--sv-energy-green);
    --danger: var(--sv-heat-red);
    --warning: var(--sv-warning-yellow);
    --dark: var(--sv-border);
    --gray: #9c91b5;
    --light-gray: #b6accb;
    --light: var(--sv-panel-base);
    --card-bg: var(--sv-panel-base);
    --text-color: var(--sv-text-main);
    --border-color: var(--sv-border-dark);
  }
}

page[data-theme='dark'] {
  --sv-bg-base: #151322;
  --sv-bg-grid: #201c34;
  --sv-panel-base: #241f38;
  --sv-panel-shadow: #0e0b17;
  --sv-border: #4d426d;
  --sv-border-dark: #120e1e;
  --sv-text-main: #f5f3fc;
  --sv-panel-light: #322b4d;
  --sv-wood-base: #463b65;
  --sv-bar-bg: #100d1a;
  
  --sv-energy-green: #38a169;
  --sv-energy-dark: #1e6b37;
  --sv-energy-light: #1c3826;
  
  --sv-heat-red: #e53e3e;
  --sv-heat-dark: #9b2c2c;
  --sv-heat-light: #441c22;
  
  --sv-coin-gold: #ecc94b;
  --sv-coin-shadow: #b7791f;
  
  --sv-warning-yellow: #d69e2e;
  --sv-warning-text: #151322;
  
  --sv-success-text: #ffffff;
  --sv-danger-text: #ffffff;

  --primary: #38a169;
  --success: var(--sv-energy-green);
  --danger: var(--sv-heat-red);
  --warning: var(--sv-warning-yellow);
  --dark: var(--sv-border);
  --gray: #9c91b5;
  --light-gray: #b6accb;
  --light: var(--sv-panel-base);
  --card-bg: var(--sv-panel-base);
  --text-color: var(--sv-text-main);
  --border-color: var(--sv-border-dark);
}

/* 主内容容器 - 兼顾平板与全面屏安全区 */
.container {
  padding: 24rpx;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

/* 农场主题主面板 (精致3rpx轮廓 + 柔和立体质感) */
.sv-panel {
  background: var(--sv-panel-base);
  border: 3.5rpx solid var(--sv-border-dark);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 0 var(--sv-panel-shadow), 0 12rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.sv-panel-light {
  background: var(--sv-panel-light);
}

/* 农场按压触感按钮系统 */
.sv-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  border: 3.5rpx solid var(--sv-border-dark);
  background: var(--sv-panel-light);
  color: var(--sv-text-main);
  box-shadow: 0 6rpx 0 var(--sv-panel-shadow);
  transition: transform 60ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 60ms cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 0.5rpx;
}

.sv-btn-hover,
.sv-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 var(--sv-panel-shadow);
}

.sv-btn-success {
  background: var(--sv-energy-green);
  color: var(--sv-success-text);
  border-color: var(--sv-energy-dark);
  box-shadow: 0 6rpx 0 var(--sv-energy-dark);
}

.sv-btn-success-hover,
.sv-btn-success:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 var(--sv-energy-dark);
}

.sv-btn-danger {
  background: var(--sv-heat-red);
  color: var(--sv-danger-text);
  border-color: var(--sv-heat-dark);
  box-shadow: 0 6rpx 0 var(--sv-heat-dark);
}

.sv-btn-danger-hover,
.sv-btn-danger:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 var(--sv-heat-dark);
}

.sv-btn-warning {
  background: var(--sv-warning-yellow);
  color: var(--sv-warning-text);
}

.sv-btn[disabled] {
  opacity: 0.55;
  filter: grayscale(0.2);
}

/* 进度条 / 燃料条 / 热量条 */
.sv-bar-wrapper {
  background-color: var(--sv-bar-bg);
  border: 3rpx solid var(--sv-border-dark);
  border-radius: 10rpx;
  height: 26rpx;
  overflow: hidden;
  position: relative;
}

.sv-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.35s ease;
}

.sv-bar-fuel .sv-bar-fill {
  background: linear-gradient(180deg, #4caf50 0%, #2e7d32 100%);
}

.sv-bar-heat .sv-bar-fill {
  background: linear-gradient(180deg, #f44336 0%, #c62828 100%);
}

/* 文字层级标准规范 */
.sv-text-main {
  color: var(--sv-text-main);
}

.sv-text-sub {
  color: var(--light-gray);
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--sv-text-main);
  margin-bottom: 12rpx;
  letter-spacing: 0.5rpx;
}

.subtitle {
  font-size: 25rpx;
  color: var(--light-gray);
  line-height: 1.45;
}

/* 像素风格专属渲染类 */
.pixel-art {
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
  image-rendering: pixelated;
}

/* 按钮并排排布通用容器 */
.btn-row {
  display: flex;
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.btn-row .sv-btn {
  flex: 1;
  margin: 0 !important;
  width: auto !important;
}

.btn-row .btn-large {
  flex: 1.8 !important;
}

/* 发音小喇叭芯片按钮 */
.sv-audio-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  margin-left: 12rpx;
  background: var(--sv-panel-light);
  border: 2.5rpx solid var(--sv-border-dark);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 0 var(--sv-panel-shadow);
  cursor: pointer;
  position: relative;
  transition: transform 50ms, box-shadow 50ms;
}

.sv-audio-btn::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
}

.sv-audio-btn:active {
  transform: translateY(3rpx);
  box-shadow: 0 1rpx 0 var(--sv-panel-shadow);
}

.sv-audio-btn.playing {
  animation: pulse-audio 0.6s infinite alternate ease-in-out;
  background: var(--sv-energy-light);
  border-color: var(--sv-energy-green);
}

.sv-audio-icon {
  font-size: 24rpx;
  line-height: 1;
}

@keyframes pulse-audio {
  0% { transform: scale(1); filter: brightness(1); }
  100% { transform: scale(1.12); filter: brightness(1.2); }
}

/* 空状态幼苗/麦穗摇曳与弹性跳跃微动效 */
.pixel-sprout-animate {
  display: inline-block;
  transform-origin: bottom center;
  animation: sprout-sway 2.4s ease-in-out infinite;
}

.pixel-bounce-animate {
  display: inline-block;
  animation: pixel-bounce 1.8s cubic-bezier(0.28, 0.84, 0.42, 1) infinite;
}

@keyframes sprout-sway {
  0%, 100% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(-8deg) scale(1.05); }
  75% { transform: rotate(8deg) scale(1.05); }
}

@keyframes pixel-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx) scale(1.06); }
}

/* 常用轻量排版辅助类 */
.flex { display: flex; }
.flex-1 { flex: 1; }
.text-center { text-align: center; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-12 { margin-bottom: 12rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
