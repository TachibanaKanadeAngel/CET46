.sv-progress {
  width: 100%;
}

.sv-progress-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--sv-text-main);
  margin-bottom: 6rpx;
}

.sv-bar-wrapper {
  background-color: var(--sv-bar-bg);
  border: 2.5rpx solid var(--sv-border-dark);
  border-radius: 12rpx;
  height: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.sv-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

.sv-fuel .sv-bar-fill {
  background: linear-gradient(90deg, #4caf50 0%, #2e7d32 100%);
}

.sv-heat .sv-bar-fill {
  background: linear-gradient(90deg, #ff7043 0%, #c62828 100%);
}

.sv-normal .sv-bar-fill {
  background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%);
}

/* 引擎状态动态动画 */
@keyframes low-fuel-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

@keyframes high-heat-blink {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.35) drop-shadow(0 0 6rpx rgba(229, 62, 62, 0.8)); }
}

.sv-alert-low-fuel .sv-bar-fill {
  animation: low-fuel-blink 1.2s infinite ease-in-out;
}

.sv-alert-high-heat .sv-bar-fill {
  animation: high-heat-blink 0.6s infinite ease-in-out;
}
