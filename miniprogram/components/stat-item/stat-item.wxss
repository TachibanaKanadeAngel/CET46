.sv-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  min-width: 120rpx;
}

.sv-stat-icon {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 6rpx;
}

.sv-stat-num {
  font-size: 38rpx;
  font-weight: 900;
  color: var(--sv-text-main);
  line-height: 1.15;
  letter-spacing: 0.5rpx;
}

.sv-stat-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--light-gray);
  margin-top: 4rpx;
}
