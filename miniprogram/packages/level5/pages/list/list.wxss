.container {
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.filter-panel {
  position: sticky;
  top: 0;
  z-index: 5;
  background: var(--sv-bg-base);
  padding: 16rpx 0 20rpx;
}

.search-row {
  position: relative;
}

.search-input {
  height: 80rpx;
  padding: 0 72rpx 0 24rpx;
  background: #fff;
  border: 3rpx solid var(--sv-border-dark);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--sv-text-main);
}

.clear-btn {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0;
  line-height: 60rpx;
  background: transparent;
  font-size: 40rpx;
  color: var(--light-gray);
}

.clear-btn::after {
  border: 0;
}

.status-picker {
  margin-top: 12rpx;
  padding: 14rpx 20rpx;
  display: flex;
  justify-content: space-between;
  background: var(--sv-panel-light);
  border: 3rpx solid var(--sv-border-dark);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--sv-text-main);
}

.empty-state {
  padding: 100rpx 0;
  text-align: center;
  color: var(--light-gray);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--light-gray);
}

.word-list {
  margin-top: 24rpx;
}

.word-item {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 3rpx solid var(--sv-border-dark);
  box-shadow: 0 4rpx 0 var(--sv-panel-shadow);
  transition: transform 50ms;
}

.word-item-hover {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 0 var(--sv-panel-shadow);
}

.word-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.word-title-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  flex: 1;
}

.word-text {
  display: inline-block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--sv-text-main);
  overflow-wrap: anywhere;
}

.list-audio-btn {
  width: 44rpx !important;
  height: 44rpx !important;
  min-height: 44rpx !important;
  padding: 0 !important;
  margin-left: 8rpx !important;
  flex-shrink: 0;
}

.list-audio-btn .sv-audio-icon {
  font-size: 22rpx;
}

.status-tag {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.08);
  color: var(--sv-text-main);
  font-size: 22rpx;
  font-weight: 600;
}

.status-tag.review {
  background: #fff8e1;
  color: #8a5a00;
}

.status-tag.mastered {
  background: #e8f5e9;
  color: #1b5e20;
}

.status-tag.wrong {
  background: #fff5f5;
  color: var(--sv-heat-red);
}

.word-phonetic {
  display: block;
  font-size: 24rpx;
  color: var(--light-gray);
  margin-top: 8rpx;
}

.word-meaning {
  display: block;
  font-size: 28rpx;
  color: var(--sv-text-main);
  margin-top: 8rpx;
}

.list-footer {
  padding: 24rpx 0 40rpx;
  color: var(--light-gray);
  font-size: 24rpx;
  text-align: center;
}