.page-bg {
  min-height: 100vh;
  background: var(--sv-bg-base);
}

.header-panel {
  text-align: center;
  padding: 28rpx 24rpx;
}

.wrong-header {
  display: flex !important;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 24rpx !important;
  text-align: left;
  gap: 16rpx;
  overflow: hidden;
}

.header-left {
  flex: 1;
  min-width: 0;
}

.wrong-header .title {
  margin-bottom: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--sv-text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wrong-header .subtitle {
  font-size: 24rpx;
  color: var(--light-gray);
  line-height: 1.4;
}

.header-actions {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.header-action-btn {
  width: 100%;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0 8rpx;
  margin: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2.5rpx solid var(--sv-border-dark);
  border-radius: 12rpx;
  background: var(--sv-panel-light);
  color: var(--sv-text-main);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 3rpx 0 var(--sv-panel-shadow);
  transition: transform 60ms ease, box-shadow 60ms ease;
}

.header-action-btn-hover,
.header-action-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 0 var(--sv-panel-shadow);
}

.header-action-btn.primary {
  background: var(--sv-energy-green);
  color: #fff;
  border-color: var(--sv-energy-dark);
  box-shadow: 0 3rpx 0 var(--sv-energy-dark);
}

.analysis-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.analysis-item {
  min-width: 0;
  min-height: 110rpx;
  padding: 10rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--sv-panel-light);
  border: 2.5rpx solid rgba(66, 38, 19, 0.18);
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--light-gray);
}

.analysis-num,
.analysis-word {
  max-width: 100%;
  color: var(--sv-text-main);
  font-size: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.analysis-word {
  font-size: 26rpx;
  color: var(--sv-heat-red);
}

.empty-state {
  text-align: center;
  padding-top: 140rpx;
}

.empty-icon {
  font-size: 88rpx;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--light-gray);
  margin-top: 16rpx;
}

.empty-btn {
  width: 60%;
  margin: 32rpx auto 0;
}

.word-list {
  margin-top: 20rpx;
}

.word-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: var(--sv-panel-light);
  border: 2.5rpx solid rgba(66, 38, 19, 0.15);
  box-shadow: 0 4rpx 0 var(--sv-panel-shadow);
  gap: 16rpx;
}

.word-info {
  flex: 1;
  min-width: 0;
}

.word-text {
  display: inline-block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--sv-text-main);
  word-break: break-all;
}

.word-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.list-audio-btn {
  width: 44rpx !important;
  height: 44rpx !important;
  min-height: 44rpx !important;
  padding: 0 !important;
  margin-left: 4rpx !important;
  flex-shrink: 0;
}

.list-audio-btn .sv-audio-icon {
  font-size: 22rpx;
}

.error-count {
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: var(--sv-heat-light);
  color: var(--sv-heat-red);
  font-size: 21rpx;
  font-weight: 700;
  border: 1.5rpx solid rgba(198, 40, 40, 0.3);
}

.word-meaning {
  display: block;
  font-size: 25rpx;
  color: var(--light-gray);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.word-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

.remove-btn {
  width: 112rpx;
  height: 52rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  background: var(--sv-heat-light);
  color: var(--sv-heat-red);
  border: 2rpx solid var(--sv-heat-red);
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  transition: transform 60ms ease, background 60ms ease;
}

.remove-btn-hover,
.remove-btn:active {
  transform: translateY(2rpx);
  background: var(--sv-heat-red);
  color: #fff;
}

.list-footer {
  padding: 24rpx 0 8rpx;
  color: var(--light-gray);
  font-size: 24rpx;
  text-align: center;
}

.error-panel {
  margin-top: 20rpx;
}
