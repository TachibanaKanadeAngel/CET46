{
  "description": "46英语 - 微信小程序版",
  "packOptions": {
    "ignore": [
      {
        "value": "tests",
        "type": "folder"
      },
      {
        "value": "project.private.config.json",
        "type": "file"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "userConfirmedBundleSwitch": false,
