{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@types/*": ["../ts/types/*"]
    },
    "typeRoots": ["../ts/types", "../node_modules/@types"]
  },
  "include": [
    "declarations.d.ts",
    "**/*.ts",
    "../ts/types/**/*.ts",
    "../ts/declarations.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
