{
  "name": "cet46-pro",
  "version": "1.3.5",
  "description": "基于 FSRS 的英语四六级科学记忆引擎",
  "author": "CET46 Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:file": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "check": "npm run lint && npm run build",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.html\"",
    "validate:vocab": "node scripts/validate-vocab.mjs",
    "cap:init": "cap init CET46Pro com.cet46.app --web-dir dist",
    "cap:add-android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open-android": "cap open android",
    "build:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --config electron-builder.json",
    "build:exe": "npm run build && npm run electron:build"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "sharp": "^0.33.0",
    "svgo": "^4.0.1",
    "vite": "^5.0.0",
    "vite-plugin-image-optimizer": "^1.1.7",
    "vite-plugin-pwa": "^0.19.0",
    "vite-plugin-singlefile": "^2.3.2",
    "workbox-precaching": "^7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TachibanaKanadeAngel/CET46.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/TachibanaKanadeAngel/CET46/issues"
  },
  "homepage": "https://github.com/TachibanaKanadeAngel/CET46#readme"
}
