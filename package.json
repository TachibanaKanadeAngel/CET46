{
  "name": "cet46-pro",
  "version": "1.0.0",
  "description": "CET4/6 智能背单词 PWA 应用",
  "type": "module",
  "main": "electron/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js/**/*.js --fix",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.html\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:init": "cap init CET46Pro com.cet46.app --web-dir dist",
    "cap:add-android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open-android": "cap open android",
    "build:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "electron:init": "npm install electron electron-builder --save-dev",
    "electron:build": "electron-builder --config electron-builder.json",
    "build:exe": "npm run build && npm run electron:build",
    "convert-icons": "node convert-icons.cjs"
  },
  "devDependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "sharp": "^0.34.5",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.6.0",
    "workbox-precaching": "^7.0.0"
  }
}
