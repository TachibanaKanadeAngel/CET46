{
  "name": "46-english",
  "version": "2.0.2",
  "description": "46英语：基于 FSRS 的英语学习工具",
  "author": "CET46 Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/index.js",
  "overrides": {
    "js-yaml": "^4.3.2",
    "tar": "^7.5.22"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:file": "vite build",
    "vercel-build": "vite build",
    "preview": "vite preview",
    "lint": "eslint js/ --ext .js,.ts",
    "lint:fix": "eslint js/ --ext .js,.ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run test && npm run build",
    "check:log": "node scripts/check-with-logging.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit && npm run mp:typecheck",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.html\"",
    "build:vocab": "node scripts/sync-vocab.mjs",
    "mp:split-vocab": "node scripts/sync-vocab.mjs",
    "mp:backfill-examples": "node scripts/backfill-examples.cjs && node scripts/sync-vocab.mjs",
    "mp:test": "node tests/miniprogram/run-all.cjs && node miniprogram/tests/run-all.cjs",
    "mp:typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p miniprogram/tsconfig.json",
    "validate:vocab": "node scripts/validate-vocab.mjs",
    "check:garbled": "node scripts/check-garbled-text.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:css": "node scripts/check-css-assets.mjs",
    "check:quality": "node scripts/check-code-quality.mjs",
    "quality:score": "node scripts/quality/quality-score.js",
    "quality:dashboard": "npx serve scripts/quality -l 8080 -s",
    "quality:check": "node scripts/quality/quality-score.js --gate",
    "quality:report": "node scripts/quality/quality-score.js --json",
    "verify": "npm run build:vocab && npm run validate:vocab && npm run check:garbled && npm run check:imports && npm run check:css && npm run check:quality && npm run check",
    "cap:init": "cap init CET46Pro com.cet46.app --web-dir dist",
    "cap:add-android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open-android": "cap open android",
    "build:apk": "npm run build && cap sync android && cd android && ./gradlew assembleRelease",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --config electron-builder.json",
    "build:exe": "npm run build:file && electron-builder --config electron-builder.json --win",
    "prepare": "husky"
  },
  "lint-staged": {
    "js/**/*.{js,ts}": [
      "eslint --ext .js,.ts"
    ]
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-image-optimizer": "^1.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.0.0"
  },
  "keywords": [
    "fsrs",
    "vocabulary",
    "cet4",
    "cet6",
    "spaced-repetition",
    "english-learning",
    "pwa"
  ]
}
